# PCB Diagnostics AI Platform Configuration

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
HOST=127.0.0.1

# Security Secrets
SECRET_KEY=pcb-diag-ai-super-secret-key-change-in-production-2026
JWT_SECRET_KEY=jwt-secret-token-key-for-pcb-diagnostics-2026
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Database
# Use SQLite locally by default, or provide PostgreSQL URI
DATABASE_URL=sqlite:///d:/own_project/storage/pcb_diagnostics.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/pcb_diagnostics

# File Storage
UPLOAD_FOLDER=d:/own_project/storage/uploads
DOCUMENTS_FOLDER=d:/own_project/storage/documents
REPORTS_FOLDER=d:/own_project/storage/reports
BOARD_PROFILES_DIR=d:/own_project/board_profiles
MAX_CONTENT_LENGTH=33554432  # 32 MB

# AI Provider Configuration
# Options: local (deterministic rules fallback), openai, ollama
AI_PROVIDER=local
AI_API_KEY=
MODEL_NAME=gpt-4o
OLLAMA_BASE_URL=http://localhost:11434

# Hardware Measurement Simulator
HARDWARE_SIMULATOR_ENABLED=True
DEFAULT_TEST_BENCH=ESP32_AUTOMATED_FIXTURE_V1
